0.05    = Verlet:       Verlet distance for optimization
0       = RenderVideo:  Write XDMF output if 1
0.4     = fraction:     Fraction of particles to appear
1.0e4   = Kn:           Normal stiffness
1.0e4   = Kt:           Tangential stiffness
0.1     = Gn:           Normal dissipative coefficient
0.0     = Gt:           Tangential dissipative coefficient
0.2     = Mu:           Microscopic friction coefficient
0.1     = R:            Sphere radius
1.0     = RRatio:       Radius ratio
1000    = seed:         Random seed
0.00001 = dt:           Time step
0.1     = dtOut:        Output interval
3.0     = Lx:           Initial specimen length
3.0     = Ly:           Initial specimen width
3.0     = Lz:           Initial specimen height
2.6     = rho:          Particle density
1.0e4   = pressure:     Isotropic target pressure
1.0     = isotropicEnd: End time for isotropic compression
-0.001  = axialVelocity: Inward speed of each axial wall during shear
2.0     = shearEnd:     End time for triaxial shear
0.01    = pidKp:        Proportional velocity gain
0.0     = pidKi:        Integral velocity gain
0.0     = pidKd:        Derivative velocity gain
