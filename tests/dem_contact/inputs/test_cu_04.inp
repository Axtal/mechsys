0.05     = Verlet:      Verlet distance for optimization
sphereboxhcp = ptype:  Particle type
normal  = test;       Typeof test, normal or sawtooth shearing
linear  = contact law  Contact law
0       = RenderVideo: 1 if video should be render
0       = Cohesion:    1 if cohesion is considered, 0 otherwise
0.55    = fraction:    Fraction of Particles to appear
2.0e6 = Kn:          Normal stiffness
2.0e6  = Kt:          Tangential stiffness
-0.5    = Gn:          Normal dissipative coefficient
0.0     = Gt:          Tangential dissipative coefficient
0.3     = Mu0:         Microscopic friction coefficient
0.3     = Mu:          Microscopic friction coefficient
0.12    = Beta:        Rolling stiffness coefficient (only for spheres)
0.0     = Eta:         Plastic moment coefficient (only for spheres, 0 if rolling resistance is not used)
2.0e4  = Bn:          Cohesion Normal stiffness
2.0e4  = Bt:          Cohesion Tangential stiffness
1.0e3  = Bm:          Cohesion Torque stiffness
0.9     = Eps:        Cohesion Threshold
0.05    = R:           Spheroradius
1234    = seed:        Seed of the random generator
2.0e-5  = dt:          Time step
0.01    = dtOut:       Time step for output
1.0     = Lx:          Lx
1.0     = Ly:          Ly
1.0     = Lz:          Lz
10      = nx:          nx
10      = ny:          ny
10      = nz:          nz
3.0     = rho:         rho
3.0   = p0:          Pressure for the isotropic compression
0.01   = str:         Strain rate
0.01     = T0:          Time span for the compression
0.02     = Tf:          Final time for the test
